# Copy to .env and fill in. Never commit .env.
# Optional. Without it the simulator runs in scripted mode, no AI needed.
# ANTHROPIC_API_KEY=
# Optional. Model to use (default claude-opus-5-5).
# MG_MODEL=
# Sent to FINRA, SEC, TreasuryDirect and FDIC so they can see who is calling. Put a contact in it.
# MG_USER_AGENT=MoneyGuardian/0.1 (contact: you@example.com)
# PORT=8790
